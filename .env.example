APP_NAME=Medi_RAG
API_PORT=8000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medirag
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/medirag
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001
DEFAULT_LLM_MODEL=qwen2.5
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3
WORKFLOW_STATE_TTL_SECONDS=3600
RETRIEVAL_CHUNK_SIZE=800
RETRIEVAL_CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_BM25_LIMIT=2000
RETRIEVAL_QUERY_REWRITE=false
MEMORY_SHORT_TTL_SECONDS=1800
# MEMORY_LONG_TTL_DAYS=365
MEMORY_LONG_TERM_LIMIT=50
MEMORY_SEMANTIC_TOP_K=5
MEMORY_SUMMARY_MAX_ITEMS=8
MEMORY_SUMMARY_MODEL=qwen2.5
VALIDATION_MIN_OVERALL_SCORE=0.75
CRITIC_MIN_OVERALL_SCORE=0.72
MAX_REFLECTION_ITERATIONS=1
